[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings_panel.gd" id="1_settings"]

[node name="SettingsPanel" type="VBoxContainer"]
theme_override_constants/separation = 2
script = ExtResource("1_settings")

[node name="MusicRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="MusicLabel" type="Label" parent="MusicRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "MUSIC"
vertical_alignment = 1

[node name="MusicSlider" type="HSlider" parent="MusicRow"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
size_flags_horizontal = 3
value = 0.8
step = 0.01

[node name="SfxRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SfxLabel" type="Label" parent="SfxRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "SFX"
vertical_alignment = 1

[node name="SfxSlider" type="HSlider" parent="SfxRow"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
size_flags_horizontal = 3
value = 0.8
step = 0.01

[node name="MuteCheck" type="CheckButton" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "MUTE"

[node name="SaveTimer" type="Timer" parent="."]
wait_time = 0.4
one_shot = true
