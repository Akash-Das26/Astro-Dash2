[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings_panel.gd" id="1_settings"]

[node name="SettingsPanel" type="VBoxContainer"]
theme_override_constants/separation = 2
script = ExtResource("1_settings")

[node name="MusicRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="MusicLabel" type="Label" parent="MusicRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "MUSIC"
vertical_alignment = 1

[node name="MusicSlider" type="HSlider" parent="MusicRow"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
size_flags_horizontal = 3
value = 0.8
step = 0.01

[node name="SfxRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SfxLabel" type="Label" parent="SfxRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "SFX"
vertical_alignment = 1

[node name="SfxSlider" type="HSlider" parent="SfxRow"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
size_flags_horizontal = 3
value = 0.8
step = 0.01

[node name="MuteCheck" type="CheckButton" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "MUTE"

[node name="MotionCheck" type="CheckButton" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "REDUCE MOTION"

[node name="AutoFireCheck" type="CheckButton" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "AUTO-FIRE (TOUCH)"

[node name="ContrastCheck" type="CheckButton" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "HIGH-CONTRAST BULLETS"
button_pressed = true

[node name="ControlsButton" type="Button" parent="."]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "REMAP CONTROLS"

[node name="ControlsNote" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.68, 0.85, 1)
theme_override_constants/line_spacing = 2
theme_override_font_sizes/font_size = 10
text = "MOVE WASD   |   FIRE SPACE   |   SECONDARY SHIFT
ESC / START PAUSE      B  BACK"
autowrap_mode = 2

[node name="AudioNote" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.56, 0.7, 1)
theme_override_font_sizes/font_size = 10
text = "AUDIO FILES COMING LATER"

[node name="SaveTimer" type="Timer" parent="."]
wait_time = 0.4
one_shot = true
