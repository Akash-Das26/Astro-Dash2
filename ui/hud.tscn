[node name="GoalLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1
autowrap_mode = 3
text = "Shoot the incoming ships before they cross the blue line.\nA boss arrives every fifth arcade wave."

[node name="ModesLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "MODES\nARCADE: endless waves, chase a high score.\nCAMPAIGN: clear a planet's waves to open the next.\nLives carry over; a boss planet gives one back.\nArrows / left stick pick, launch to fight."

[node name="KeyboardLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "KEYBOARD\nA / D or Left / Right   move\nSpace   fire\nP or Esc   pause"

[node name="GamepadLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "GAMEPAD\nLeft stick   move\nA / Cross   fire\nStart   pause"

[node name="TouchLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "TOUCH\nDrag anywhere on the lower half to steer.\nThe ship fires while your finger is down.\nWith auto-fire off, hold FIRE in the corner.\nThe II button in the top right pauses."

[node name="PickupLabel" type="Label" parent="Root/HelpPanel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
text = "PICKUPS\nR rapid fire   S spread shot   H shield   B bomb"

